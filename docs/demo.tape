# Regenerate with: just demo
Output docs/demo.gif

Require leet

Set Shell bash
Set FontSize 18
Set Width 1100
Set Height 560
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms

Hide
Type "export PS1='$ ' && clear"
Enter
Show

Type "leet encode Hack the planet"
Enter
Sleep 1.2s
Type "leet encode --level basic Hack the planet"
Enter
Sleep 1.2s
Type "leet encode --random Hack the planet"
Enter
Sleep 1.2s
Type "leet encode 'leet speak' | leet decode"
Enter
Sleep 1.2s
Type "leet detect 'h4ck th3 p14n37'"
Enter
Sleep 1.5s
Type `leet decode --animate '|*455\/\/0|2|) 4<<3|*73|), \/\/3|_<0/\/\3 84<|<'`
Enter
Sleep 3s
Type "leet share 'meet me at the usual place'"
Enter
Sleep 2s

Type "clear && leet"
Enter
Sleep 1s
Type@70ms "Hello World"
Sleep 1s
Ctrl+L
Sleep 2.4s
Ctrl+R
Sleep 2.4s
Ctrl+S
Sleep 2.4s
Tab
Sleep 2.4s
Escape
Sleep 0.5s
